rules_version = '2';

// Dining Log — single-owner site.
//
// Only the OWNER (one specific uid) may write. Everyone else — including
// signed-out visitors — can READ, so the public rating list is viewable
// by anyone with no account.
//
// ⚠ Replace OWNER_UID below with your Firebase Auth uid
//   (Console → Authentication → Users → your row → User UID).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.uid == "OWNER_UID";
    }

    match /meals/{docId} {
      allow read: if true;          // public
      allow write: if isOwner();    // only you
    }

    match /dishes/{docId} {
      allow read: if true;          // public
      allow write: if isOwner();    // only you
    }
  }
}
