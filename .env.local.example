# Firebase Web Config (safe to expose — these are public identifiers,
# not secrets. Access is controlled by Firebase Auth + Firestore Rules).
# Find these in Firebase Console → Project Settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
NEXT_PUBLIC_OWNER_UID=firebase-auth-uid

# For GitHub Pages PROJECT sites (username.github.io/repo-name),
# set this to "/repo-name". Leave blank for user sites or local dev.
# NEXT_PUBLIC_BASE_PATH=/nittanybites

# ── Server-side scripts only (import-data, log-meal). NOT bundled to the client.
# Admin SDK service account (choose ONE):
#   GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ... }
# Whose account to write to (choose ONE):
#   TARGET_EMAIL=you@psu.edu
#   TARGET_UID=firebase-auth-uid
# Gemini AI logger:
#   GEMINI_API_KEY=your-gemini-key
#   GEMINI_MODEL=gemini-2.5-flash
